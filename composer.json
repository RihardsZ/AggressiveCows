{
    "require-dev": {
        "pestphp/pest": "^5.3",
        "symfony/process": "^8.1",
        "laravel/pint": "^1.32",
        "squizlabs/php_codesniffer": "^4.0",
        "phpmd/phpmd": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AggressiveCows\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    },
    "require": {
        "php": "^8.4"
    }
}
